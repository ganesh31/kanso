{
  "components": {
    "schemas": {
      "Bar": {
        "additionalProperties": false,
        "properties": {
          "close": {
            "format": "double",
            "type": "number"
          },
          "date": {
            "type": "string"
          },
          "high": {
            "format": "double",
            "type": "number"
          },
          "low": {
            "format": "double",
            "type": "number"
          },
          "open": {
            "format": "double",
            "type": "number"
          },
          "volume": {
            "format": "double",
            "type": "number"
          }
        },
        "required": [
          "date",
          "open",
          "high",
          "low",
          "close",
          "volume"
        ],
        "type": "object"
      },
      "BarsOutputBody": {
        "additionalProperties": false,
        "properties": {
          "bars": {
            "items": {
              "$ref": "#/components/schemas/Bar"
            },
            "type": "array"
          },
          "symbol": {
            "type": "string"
          }
        },
        "required": [
          "symbol",
          "bars"
        ],
        "type": "object"
      },
      "CondOutcome": {
        "additionalProperties": false,
        "properties": {
          "condition": {
            "$ref": "#/components/schemas/Condition"
          },
          "group": {
            "enum": [
              "all",
              "any"
            ],
            "type": "string"
          },
          "index": {
            "description": "Position within its group",
            "format": "int64",
            "type": "integer"
          },
          "result": {
            "$ref": "#/components/schemas/Result"
          }
        },
        "required": [
          "group",
          "index",
          "condition",
          "result"
        ],
        "type": "object"
      },
      "Condition": {
        "additionalProperties": false,
        "properties": {
          "params": {
            "additionalProperties": {},
            "type": "object"
          },
          "type": {
            "type": "string"
          }
        },
        "required": [
          "type"
        ],
        "type": "object"
      },
      "Costs": {
        "additionalProperties": false,
        "properties": {
          "per_side_pct": {
            "description": "Brokerage and statutory charges, % per side",
            "format": "double",
            "type": "number"
          },
          "slippage_pct": {
            "description": "Slippage, % per side",
            "format": "double",
            "type": "number"
          }
        },
        "required": [
          "per_side_pct",
          "slippage_pct"
        ],
        "type": "object"
      },
      "Entry": {
        "additionalProperties": false,
        "properties": {
          "all": {
            "items": {
              "$ref": "#/components/schemas/Condition"
            },
            "type": "array"
          },
          "any": {
            "items": {
              "$ref": "#/components/schemas/Condition"
            },
            "type": "array"
          }
        },
        "required": [
          "all"
        ],
        "type": "object"
      },
      "ErrorDetail": {
        "additionalProperties": false,
        "properties": {
          "location": {
            "description": "Where the error occurred, e.g. 'body.items[3].tags' or 'path.thing-id'",
            "type": "string"
          },
          "message": {
            "description": "Error message text",
            "type": "string"
          },
          "value": {
            "description": "The value at the given location"
          }
        },
        "type": "object"
      },
      "ErrorModel": {
        "additionalProperties": false,
        "properties": {
          "detail": {
            "description": "A human-readable explanation specific to this occurrence of the problem.",
            "examples": [
              "Property foo is required but is missing."
            ],
            "type": "string"
          },
          "errors": {
            "description": "Optional list of individual error details",
            "items": {
              "$ref": "#/components/schemas/ErrorDetail"
            },
            "type": "array"
          },
          "instance": {
            "description": "A URI reference that identifies the specific occurrence of the problem.",
            "examples": [
              "https://example.com/error-log/abc123"
            ],
            "format": "uri",
            "type": "string"
          },
          "status": {
            "description": "HTTP status code",
            "examples": [
              400
            ],
            "format": "int64",
            "type": "integer"
          },
          "title": {
            "description": "A short, human-readable summary of the problem type. This value should not change between occurrences of the error.",
            "examples": [
              "Bad Request"
            ],
            "type": "string"
          },
          "type": {
            "default": "about:blank",
            "description": "A URI reference to human-readable documentation for the error.",
            "examples": [
              "https://example.com/errors/example"
            ],
            "format": "uri",
            "type": "string"
          }
        },
        "type": "object"
      },
      "Evidence": {
        "description": "Evidence behind one condition's verdict, discriminated by type.",
        "discriminator": {
          "mapping": {
            "level_age": "#/components/schemas/LevelAgeEvidence",
            "n_year_high": "#/components/schemas/NYearHighEvidence",
            "not_evaluable": "#/components/schemas/NotEvaluable",
            "not_extended": "#/components/schemas/NotExtendedEvidence",
            "relative_strength": "#/components/schemas/RSEvidence",
            "volume_surge": "#/components/schemas/VolumeEvidence"
          },
          "propertyName": "type"
        },
        "oneOf": [
          {
            "$ref": "#/components/schemas/NYearHighEvidence"
          },
          {
            "$ref": "#/components/schemas/LevelAgeEvidence"
          },
          {
            "$ref": "#/components/schemas/NotExtendedEvidence"
          },
          {
            "$ref": "#/components/schemas/RSEvidence"
          },
          {
            "$ref": "#/components/schemas/VolumeEvidence"
          },
          {
            "$ref": "#/components/schemas/NotEvaluable"
          }
        ]
      },
      "Exits": {
        "additionalProperties": false,
        "properties": {
          "stop_pct": {
            "description": "Stop-loss, % below the entry fill",
            "format": "double",
            "type": "number"
          },
          "trend_sma_weeks": {
            "description": "Exit when a weekly close is below this SMA of weekly closes; 0 disables",
            "format": "int64",
            "type": "integer"
          }
        },
        "required": [
          "stop_pct",
          "trend_sma_weeks"
        ],
        "type": "object"
      },
      "LevelAgeEvidence": {
        "additionalProperties": false,
        "properties": {
          "bars_since": {
            "format": "int64",
            "type": "integer"
          },
          "level_date": {
            "type": "string"
          },
          "type": {
            "enum": [
              "level_age"
            ],
            "type": "string"
          }
        },
        "required": [
          "type",
          "bars_since",
          "level_date"
        ],
        "type": "object"
      },
      "Match": {
        "additionalProperties": false,
        "properties": {
          "date": {
            "description": "Bar evaluated: the as-of day, or the last complete week",
            "type": "string"
          },
          "level": {
            "format": "double",
            "type": "number"
          },
          "level_age_bars": {
            "description": "Bars since the level was set",
            "format": "int64",
            "type": "integer"
          },
          "level_date": {
            "type": "string"
          },
          "outcome": {
            "$ref": "#/components/schemas/Outcome"
          },
          "pct_above": {
            "description": "Close above the level, in percent",
            "format": "double",
            "type": "number"
          },
          "provisional": {
            "$ref": "#/components/schemas/Outcome",
            "description": "The rule on the week in progress (weekly only)"
          },
          "rs_diff": {
            "description": "Stock return minus benchmark return, as a fraction",
            "format": "double",
            "type": "number"
          },
          "signal_date": {
            "description": "Latest signal in the fresh window (fresh mode)",
            "type": "string"
          },
          "symbol": {
            "type": "string"
          },
          "true_since": {
            "description": "First bar of the current pass streak (all mode)",
            "type": "string"
          },
          "vol_ratio": {
            "description": "Volume over the prior window's average",
            "format": "double",
            "type": "number"
          }
        },
        "required": [
          "symbol",
          "date",
          "outcome"
        ],
        "type": "object"
      },
      "Meta": {
        "additionalProperties": false,
        "properties": {
          "description": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "params": {
            "items": {
              "$ref": "#/components/schemas/ParamSpec"
            },
            "type": "array"
          },
          "provides": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "requires": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "type": {
            "type": "string"
          }
        },
        "required": [
          "type",
          "label",
          "description",
          "params",
          "provides",
          "requires"
        ],
        "type": "object"
      },
      "NYearHighEvidence": {
        "additionalProperties": false,
        "properties": {
          "bars_since": {
            "format": "int64",
            "type": "integer"
          },
          "close": {
            "format": "double",
            "type": "number"
          },
          "level": {
            "format": "double",
            "type": "number"
          },
          "level_date": {
            "type": "string"
          },
          "pct_above": {
            "format": "double",
            "type": "number"
          },
          "type": {
            "enum": [
              "n_year_high"
            ],
            "type": "string"
          }
        },
        "required": [
          "type",
          "level",
          "level_date",
          "bars_since",
          "close",
          "pct_above"
        ],
        "type": "object"
      },
      "NotEvaluable": {
        "additionalProperties": false,
        "properties": {
          "reason": {
            "enum": [
              "insufficient_history",
              "data_gap",
              "benchmark_missing",
              "no_breakout_level",
              "zero_denominator",
              "incomplete_bar"
            ],
            "type": "string"
          },
          "type": {
            "enum": [
              "not_evaluable"
            ],
            "type": "string"
          }
        },
        "required": [
          "type",
          "reason"
        ],
        "type": "object"
      },
      "NotExtendedEvidence": {
        "additionalProperties": false,
        "properties": {
          "pct_above": {
            "format": "double",
            "type": "number"
          },
          "type": {
            "enum": [
              "not_extended"
            ],
            "type": "string"
          }
        },
        "required": [
          "type",
          "pct_above"
        ],
        "type": "object"
      },
      "Outcome": {
        "additionalProperties": false,
        "properties": {
          "any_matched": {
            "description": "Indexes of the ANY branches that passed",
            "items": {
              "format": "int64",
              "type": "integer"
            },
            "type": "array"
          },
          "conditions": {
            "items": {
              "$ref": "#/components/schemas/CondOutcome"
            },
            "type": "array"
          },
          "evaluable": {
            "type": "boolean"
          },
          "pass": {
            "type": "boolean"
          }
        },
        "required": [
          "pass",
          "evaluable",
          "conditions",
          "any_matched"
        ],
        "type": "object"
      },
      "ParamSpec": {
        "additionalProperties": false,
        "properties": {
          "default": {},
          "kind": {
            "enum": [
              "number",
              "bool",
              "symbol"
            ],
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "max": {
            "format": "double",
            "type": "number"
          },
          "min": {
            "format": "double",
            "type": "number"
          },
          "name": {
            "type": "string"
          },
          "step": {
            "format": "double",
            "type": "number"
          },
          "unit": {
            "enum": [
              "",
              "weeks",
              "months",
              "years"
            ],
            "type": "string"
          }
        },
        "required": [
          "name",
          "label",
          "kind",
          "unit",
          "default",
          "min",
          "max",
          "step"
        ],
        "type": "object"
      },
      "PatternsOutputBody": {
        "additionalProperties": false,
        "properties": {
          "patterns": {
            "items": {
              "$ref": "#/components/schemas/Meta"
            },
            "type": "array"
          }
        },
        "required": [
          "patterns"
        ],
        "type": "object"
      },
      "Portfolio": {
        "additionalProperties": false,
        "properties": {
          "capital": {
            "description": "Starting capital in rupees",
            "format": "double",
            "type": "number"
          },
          "max_positions": {
            "description": "Maximum concurrent positions",
            "format": "int64",
            "type": "integer"
          }
        },
        "required": [
          "capital",
          "max_positions"
        ],
        "type": "object"
      },
      "QuickscanRequest": {
        "additionalProperties": false,
        "properties": {
          "as_of": {
            "description": "Scan as of this date (default: the latest benchmark date)",
            "format": "date",
            "type": "string"
          },
          "mode": {
            "default": "fresh",
            "description": "fresh: signalled within the last 5 daily / 1 weekly bars; all: qualifying now",
            "enum": [
              "fresh",
              "all"
            ],
            "type": "string"
          },
          "params": {
            "additionalProperties": {},
            "description": "Param values; missing ones take their defaults",
            "type": "object"
          },
          "pattern": {
            "description": "Pattern or filter type, from /api/patterns",
            "type": "string"
          },
          "timeframe": {
            "default": "daily",
            "enum": [
              "daily",
              "weekly"
            ],
            "type": "string"
          },
          "universe": {
            "type": "string"
          }
        },
        "required": [
          "pattern",
          "universe"
        ],
        "type": "object"
      },
      "RSEvidence": {
        "additionalProperties": false,
        "properties": {
          "bench_return": {
            "format": "double",
            "type": "number"
          },
          "diff": {
            "format": "double",
            "type": "number"
          },
          "stock_return": {
            "format": "double",
            "type": "number"
          },
          "type": {
            "enum": [
              "relative_strength"
            ],
            "type": "string"
          }
        },
        "required": [
          "type",
          "stock_return",
          "bench_return",
          "diff"
        ],
        "type": "object"
      },
      "Report": {
        "additionalProperties": false,
        "properties": {
          "as_of": {
            "description": "Date of the bar evaluated, from the data; empty if there is none",
            "type": "string"
          },
          "level": {
            "description": "Breakout level at as_of, if any",
            "format": "double",
            "type": "number"
          },
          "level_date": {
            "description": "Date the breakout level was set",
            "type": "string"
          },
          "lines": {
            "items": {
              "$ref": "#/components/schemas/ReportLine"
            },
            "type": "array"
          },
          "symbol": {
            "type": "string"
          },
          "timeframe": {
            "enum": [
              "daily",
              "weekly"
            ],
            "type": "string"
          }
        },
        "required": [
          "symbol",
          "as_of",
          "timeframe",
          "lines"
        ],
        "type": "object"
      },
      "ReportLine": {
        "additionalProperties": false,
        "properties": {
          "label": {
            "type": "string"
          },
          "params": {
            "additionalProperties": {},
            "type": "object"
          },
          "result": {
            "$ref": "#/components/schemas/Result"
          },
          "type": {
            "type": "string"
          }
        },
        "required": [
          "type",
          "label",
          "params",
          "result"
        ],
        "type": "object"
      },
      "ReportRequest": {
        "additionalProperties": false,
        "properties": {
          "as_of": {
            "description": "Evaluate the last bar on or before this date (default: latest)",
            "format": "date",
            "type": "string"
          },
          "timeframe": {
            "default": "daily",
            "description": "Bars to evaluate on; weekly bars are complete ISO weeks built from daily bars",
            "enum": [
              "daily",
              "weekly"
            ],
            "type": "string"
          }
        },
        "type": "object"
      },
      "Result": {
        "additionalProperties": false,
        "properties": {
          "evaluable": {
            "type": "boolean"
          },
          "evidence": {
            "$ref": "#/components/schemas/Evidence"
          },
          "pass": {
            "type": "boolean"
          }
        },
        "required": [
          "pass",
          "evaluable",
          "evidence"
        ],
        "type": "object"
      },
      "ScanResult": {
        "additionalProperties": false,
        "properties": {
          "as_of": {
            "description": "Date scanned, from the data",
            "type": "string"
          },
          "auto_inserted": {
            "description": "Condition types added because the pattern needs them",
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "matches": {
            "items": {
              "$ref": "#/components/schemas/Match"
            },
            "type": "array"
          },
          "skipped": {
            "description": "Stocks with no bars up to as_of",
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "stale": {
            "description": "Stocks whose last bar is before as_of; never matched",
            "items": {
              "type": "string"
            },
            "type": "array"
          }
        },
        "required": [
          "as_of",
          "matches",
          "stale",
          "skipped",
          "auto_inserted"
        ],
        "type": "object"
      },
      "System": {
        "additionalProperties": false,
        "properties": {
          "costs": {
            "$ref": "#/components/schemas/Costs"
          },
          "entry": {
            "$ref": "#/components/schemas/Entry"
          },
          "exits": {
            "$ref": "#/components/schemas/Exits"
          },
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "portfolio": {
            "$ref": "#/components/schemas/Portfolio"
          },
          "timeframe": {
            "enum": [
              "daily",
              "weekly"
            ],
            "type": "string"
          },
          "universe": {
            "type": "string"
          }
        },
        "required": [
          "name",
          "universe",
          "entry"
        ],
        "type": "object"
      },
      "Universe": {
        "additionalProperties": false,
        "properties": {
          "has_history": {
            "description": "False when only today's members are known (survivorship bias)",
            "type": "boolean"
          },
          "members": {
            "format": "int64",
            "type": "integer"
          },
          "name": {
            "type": "string"
          }
        },
        "required": [
          "name",
          "members",
          "has_history"
        ],
        "type": "object"
      },
      "UniversesOutputBody": {
        "additionalProperties": false,
        "properties": {
          "universes": {
            "items": {
              "$ref": "#/components/schemas/Universe"
            },
            "type": "array"
          }
        },
        "required": [
          "universes"
        ],
        "type": "object"
      },
      "ValidateOutputBody": {
        "additionalProperties": false,
        "properties": {
          "system": {
            "$ref": "#/components/schemas/System"
          }
        },
        "required": [
          "system"
        ],
        "type": "object"
      },
      "VolumeEvidence": {
        "additionalProperties": false,
        "properties": {
          "avg_volume": {
            "format": "double",
            "type": "number"
          },
          "ratio": {
            "format": "double",
            "type": "number"
          },
          "type": {
            "enum": [
              "volume_surge"
            ],
            "type": "string"
          }
        },
        "required": [
          "type",
          "ratio",
          "avg_volume"
        ],
        "type": "object"
      }
    }
  },
  "info": {
    "description": "Multi-year breakout scanner, stock report and system builder for NSE equities.",
    "title": "Kanso API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/bars/{symbol}": {
      "get": {
        "operationId": "get-bars",
        "parameters": [
          {
            "in": "path",
            "name": "symbol",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "First date (inclusive); default: the first bar",
            "explode": false,
            "in": "query",
            "name": "from",
            "schema": {
              "description": "First date (inclusive); default: the first bar",
              "format": "date",
              "type": "string"
            }
          },
          {
            "description": "Last date (inclusive); default: the last bar",
            "explode": false,
            "in": "query",
            "name": "to",
            "schema": {
              "description": "Last date (inclusive); default: the last bar",
              "format": "date",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BarsOutputBody"
                }
              }
            },
            "description": "OK"
          },
          "400": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorModel"
                }
              }
            },
            "description": "Bad Request"
          },
          "404": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorModel"
                }
              }
            },
            "description": "Not Found"
          },
          "422": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorModel"
                }
              }
            },
            "description": "Unprocessable Entity"
          },
          "500": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorModel"
                }
              }
            },
            "description": "Internal Server Error"
          }
        },
        "summary": "Daily bars for one chart"
      }
    },
    "/api/patterns": {
      "get": {
        "operationId": "list-patterns",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PatternsOutputBody"
                }
              }
            },
            "description": "OK"
          },
          "default": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorModel"
                }
              }
            },
            "description": "Error"
          }
        },
        "summary": "List every registered pattern and its params"
      }
    },
    "/api/quickscan": {
      "post": {
        "operationId": "quick-scan",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
